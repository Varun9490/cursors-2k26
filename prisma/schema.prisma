generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  name      String?
  createdAt DateTime @default(now())
  
  documents Document[]
}

model Document {
  id         String   @id @default(cuid())
  userId     String
  content    String   @db.Text
  filename   String
  uploadedAt DateTime @default(now())
  
  // Text fingerprint for quick similarity detection
  contentHash    String?   @db.VarChar(64)  // SHA-256 hash of normalized content
  wordCount      Int?
  
  user              User               @relation(fields: [userId], references: [id])
  report            PlagiarismReport?
  citations         Citation[]
  fingerprints      DocumentFingerprint[]
  similarDocuments  SimilarDocument[]  @relation("SourceDocument")
  matchedBy         SimilarDocument[]  @relation("MatchedDocument")

  @@index([userId, uploadedAt])
  @@index([contentHash])
}


model PlagiarismReport {
  id               String   @id @default(cuid())
  documentId       String   @unique
  originalityScore Float
  matchedSources   Json
  createdAt        DateTime @default(now())
  
  // Enhanced metadata
  webMatchCount    Int?     @default(0)
  patternMatchCount Int?    @default(0)
  internalMatchCount Int?   @default(0)  // Matches with other documents in DB
  processingTimeMs Int?
  verdict          String?  // ORIGINAL, MOSTLY_ORIGINAL, SUSPICIOUS, LIKELY_PLAGIARIZED

  document         Document @relation(fields: [documentId], references: [id])
  matches          PlagiarismMatch[]

  @@index([documentId, createdAt])
  @@index([originalityScore])
}

model PlagiarismMatch {
  id              String   @id @default(cuid())
  reportId        String
  originalText    String   @db.Text
  matchedText     String   @db.Text
  sourceUrl       String?
  sourceTitle     String
  similarityScore Float
  matchType       String // DIRECT, PARAPHRASED, SIMILAR, PATTERN, INTERNAL
  position        Json?    // { startIndex, endIndex }
  createdAt       DateTime @default(now())

  report          PlagiarismReport @relation(fields: [reportId], references: [id])

  @@index([reportId])
}

model Citation {
  id                  String   @id @default(cuid())
  documentId          String
  citationText        String   @db.Text
  validityStatus      String   // VERIFIED, SUSPICIOUS, INVALID
  validityScore       Int      @default(0)
  issues              Json
  verificationDetails Json?    // { doi, scholar, url, ai }
  suggestedCorrection String?  @db.Text
  verifiedAt          DateTime @default(now())
  createdAt           DateTime @default(now())

  document            Document @relation(fields: [documentId], references: [id])

  @@index([documentId])
}

// =====================================================
// NEW: Document Fingerprinting for Internal Plagiarism Detection
// =====================================================

model DocumentFingerprint {
  id          String   @id @default(cuid())
  documentId  String
  
  // N-gram based fingerprints (shingles)
  fingerprint String   @db.VarChar(64)  // Hash of text shingle
  shingleText String?  @db.Text         // Original shingle text (optional, for debugging)
  position    Int                        // Position in document
  
  createdAt   DateTime @default(now())

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([fingerprint])
  @@index([documentId])
}

// Track similar documents found in the database
model SimilarDocument {
  id              String   @id @default(cuid())
  sourceDocId     String
  matchedDocId    String
  
  similarityScore Float    // 0-100 percentage
  matchType       String   // EXACT, NEAR_DUPLICATE, PARTIAL
  sharedFingerprints Int   // Number of matching fingerprints
  
  createdAt       DateTime @default(now())

  sourceDocument  Document @relation("SourceDocument", fields: [sourceDocId], references: [id], onDelete: Cascade)
  matchedDocument Document @relation("MatchedDocument", fields: [matchedDocId], references: [id], onDelete: Cascade)

  @@unique([sourceDocId, matchedDocId])
  @@index([sourceDocId])
  @@index([matchedDocId])
  @@index([similarityScore])
}
