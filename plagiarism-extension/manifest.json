{
    "manifest_version": 3,
    "name": "PlagDetect - AI Plagiarism Checker",
    "version": "1.1.0",
    "description": "Check text and code for plagiarism instantly. Features offline pattern analysis, AI detection, and web source matching.",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "activeTab",
        "contextMenus",
        "storage",
        "scripting",
        "notifications"
    ],
    "host_permissions": [
        "https://cursors-2k26.vercel.app/*",
        "http://localhost:3000/*",
        "<all_urls>"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "PlagDetect - Check Plagiarism",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "commands": {
        "quick-check": {
            "suggested_key": {
                "default": "Ctrl+Shift+P",
                "mac": "Command+Shift+P"
            },
            "description": "Quick plagiarism check on selected text"
        },
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+P",
                "mac": "Alt+P"
            },
            "description": "Open PlagDetect popup"
        }
    }
}